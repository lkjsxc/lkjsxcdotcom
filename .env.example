# Copy outside Git and replace only deployment-specific placeholders.
APP_BIND_ADDR=0.0.0.0
APP_PORT=18081
APP_DATA_DIR=/var/lib/lkjsxcdotcom/data
APP_PUBLIC_DIR=/var/lib/lkjsxcdotcom/public
APP_IMPORTED_ASSETS_DIR=/var/lib/lkjsxcdotcom/imported-assets
APP_TRUSTED_PROXY_CIDR=REPLACE_WITH_EDGE_PROXY_CIDR
